<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9F4">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="30dp">

        <!-- Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐾"
            android:textSize="70sp"
            android:layout_marginTop="40dp"/>

        <!-- Nombre de la aplicación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi Mascota Segura"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2E5D34"
            android:layout_marginTop="10dp"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cuida, registra y protege a tu mascota"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="35dp"/>

        <!-- Correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtCorreo"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ingresa tu correo"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"/>

        <!-- Contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contraseña"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Ingresa tu contraseña"
            android:inputType="textPassword"
            android:padding="15dp"
            android:layout_marginTop="8dp"/>

        <!-- Ingresar -->
        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#2E7D32"
            android:onClick="btnIngresar"
            android:text="INGRESAR"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Pregunta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿No tienes cuenta?"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="30dp"/>

        <!-- Registrarme -->
        <Button
            android:id="@+id/btnRegistrarme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            android:onClick="btnRegistrarme"
            android:text="REGISTRARME"
            android:textColor="#2E7D32"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>