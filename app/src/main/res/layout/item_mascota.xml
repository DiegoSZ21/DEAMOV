<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Foto -->

        <ImageView
            android:id="@+id/ivFotoItemMascota"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_ornitorrinco" />

        <!-- Nombre -->

        <TextView
            android:id="@+id/tvNombreMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de mascota"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Información -->

        <TextView
            android:id="@+id/tvInformacionMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Perro | Bulldog | Macho"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- Propietario -->

        <TextView
            android:id="@+id/tvPropietarioMascota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Propietario: Juan Pérez"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>